{
  "name": "siteforge",
  "version": "1.0.0",
  "description": "Internal Sales & Website Generation Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web"
  },
  "keywords": [
    "lead-generation",
    "website-builder",
    "sales-automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@nodelib/fs.stat": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
