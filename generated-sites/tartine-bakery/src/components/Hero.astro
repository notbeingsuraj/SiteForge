---
// Hero — value proposition + primary CTA. Renders only verified business facts.
// CTA hrefs resolve to available channels (phone/website/directions); missing
// channels are omitted rather than fabricated.
import { siteConfig, ctaHref } from '../lib/site';

const b = siteConfig.business;
const copy = siteConfig.copy.hero;
const category = b.category || (b.categories && b.categories[0]) || null;
const primaryCta = siteConfig.primaryCta;
const primaryHref = primaryCta.href || ctaHref(primaryCta.action) || ctaHref('contact');
const secondaryHref = siteConfig.secondaryCta?.href || null;

const safeHeadline = copy?.headline || b.name || 'Welcome';
const safeSub = copy?.subheadline || (b.description ? b.description : null);
---

<section class="hero">
  <div class="container">
    {category && <span class="hero__eyebrow">{category}</span>}
    <h1 class="hero__title">{safeHeadline}</h1>
    {safeSub && <p class="hero__sub">{safeSub}</p>}
    <div class="hero__actions">
      {primaryHref && primaryCta?.text && <a class="btn btn--primary" href={primaryHref}>{primaryCta.text}</a>}
      {secondaryHref && siteConfig.secondaryCta?.text && <a class="btn btn--secondary" href={secondaryHref}>{siteConfig.secondaryCta.text}</a>}
    </div>
  </div>
</section>
