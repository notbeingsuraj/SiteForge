# Server Configuration
PORT=5001
NODE_ENV=development

# AI Configuration (OmniRoute)
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Google Maps API (for Places API - New)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable: Places API (New), Maps JavaScript API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL=http://localhost:5173

# Debug
DEBUG_BUSINESS_ANALYSIS=false

# Extraction Configuration
EXTRACTION_TIMEOUT_MS=15000
EXTRACTION_MAX_RETRIES=2
