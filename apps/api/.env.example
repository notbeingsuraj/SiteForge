# Server Configuration
PORT=5001
NODE_ENV=development

# AI Configuration (OmniRoute)
# Place your real key in apps/api/.env (gitignored). Never commit a real key here.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL=http://localhost:5173

# Geoapify Places API (backend only — never place the real key here, never expose to frontend)
GEOAPIFY_API_KEY=

# SQLite Database (for persistent business identity)
# Leave empty for default: ./webloom.db in apps/api directory
SQLITE_DATABASE_PATH=

# Debug
DEBUG_BUSINESS_ANALYSIS=false

# Extraction Configuration
EXTRACTION_TIMEOUT_MS=15000
EXTRACTION_MAX_RETRIES=2
