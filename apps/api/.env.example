# Server Configuration
PORT=5001
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI Configuration (OmniRoute)
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL=http://localhost:5173
GOOGLE_MAPS_API_KEY=
DEBUG_BUSINESS_ANALYSIS=false
OMNIROUTE_FAST_MODEL=gpt-3.5-turbo
OMNIROUTE_REASONING_MODEL=gpt-4-turbo
OMNIROUTE_CODING_MODEL=gpt-4-turbo
OMNIROUTE_COPYWRITING_MODEL=gpt-4-turbo
