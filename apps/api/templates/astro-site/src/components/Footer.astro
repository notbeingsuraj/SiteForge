---
// Footer — brand + verified address/city; no fabricated detail.
import { siteConfig } from '../lib/site';

const b = siteConfig.business;
const year = new Date().getFullYear();
const locationLine = [b.address, b.city, b.state].filter(Boolean).join(', ');
---

<footer class="footer">
  <div class="container">
    <p><strong>{b.name || siteConfig.site.title}</strong></p>
    {locationLine && <p>{locationLine}</p>}
    <p>© {year} {b.name || siteConfig.site.title}. Generated locally by SiteForge.</p>
  </div>
</footer>
