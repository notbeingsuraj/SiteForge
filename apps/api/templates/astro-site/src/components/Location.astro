---
// Location — verified address, city/state, and a directions link when
// coordinates or an address are present. Omits parts with no verified data.
import { siteConfig, directionsHref } from '../lib/site';

const b = siteConfig.business;
const line = [b.address, b.city, b.state, b.postalCode, b.country].filter(Boolean);
const dirHref = directionsHref(b.latitude, b.longitude, b.address);
const has = b.address || b.city || (b.latitude != null && b.longitude != null);
---

{#if has}
<section id="location" class="section section--surface" style="scroll-margin-top:4rem">
  <div class="container">
    <h2 class="section__title">Location</h2>
    <div class="grid grid--3">
      <div>
        <ul class="info-list">
          {line.length > 0 && (
            <li><span class="info-icon">📍</span><span>{line.join(', ')}</span></li>
          )}
          {b.latitude != null && b.longitude != null && (
            <li><span class="info-icon">🌐</span><span>{b.latitude.toFixed(4)}, {b.longitude.toFixed(4)}</span></li>
          )}
        </ul>
        {dirHref && <p style="margin-top:1.25rem"><a class="btn btn--secondary" href={dirHref} target="_blank" rel="noopener">Get Directions</a></p>}
      </div>
    </div>
  </div>
</section>
{/if}
