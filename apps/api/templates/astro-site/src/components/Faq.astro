---
// Faq — frequently asked questions from generated copy. Omitted by the
// generator when no FAQ content exists.
import { siteConfig } from '../lib/site';

const faq = siteConfig.copy.faq || [];
---

{#if faq.length > 0}
<section id="faq" class="section section--surface" style="scroll-margin-top:4rem">
  <div class="container">
    <h2 class="section__title">FAQ</h2>
    <div class="grid" style="max-width:46rem">
      {faq.map((f) => (
        <details key={f.question}>
          <summary>{f.question}</summary>
          <p style="margin:0.75rem 0 0">{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
{/if}
