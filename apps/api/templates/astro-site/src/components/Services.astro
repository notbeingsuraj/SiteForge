---
// Services — from verified services/category list + generated copy. Never invented.
import { siteConfig } from '../lib/site';

const b = siteConfig.business;
const svc = siteConfig.copy.services;
// Prefer generated service items; fall back to verified category names.
const items = (svc?.items && svc.items.length ? svc.items : [])
  .concat((b.categories || []).filter((c) => c && !(svc?.items || []).some((i) => (i.name || '').toLowerCase() === c.toLowerCase())).map((c) => ({ name: c, description: '' })));
---

<section id="services" class="section section--surface" style="scroll-margin-top:4rem">
  <div class="container">
    <h2 class="section__title">{svc?.heading || 'Services'}</h2>
    {items.length > 0 ? (
      <div class="grid grid--3">
        {items.map((item, i) => (
          <div class="card" key={item.name || i}>
            <h3 class="card__title">{item.name}</h3>
            {item.description && <p class="card__text">{item.description}</p>}
            {item.benefits && item.benefits.length > 0 && (
              <ul class="muted-note">
                {item.benefits.map((f) => <li key={f}>{f}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    ) : (
      <p class="section__lead">{b.name || 'This business'} has not shared additional services.</p>
    )}
  </div>
</section>
